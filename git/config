[core]
    commitGraph = true
	filemode = true
[alias]
    acp = !"git add -A && git ci --amend --no-edit && git push --force-with-lease"
    br = branch
    ci = commit
	co = checkout
    l = log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%ci) %C(bold blue)<%an>%Creset'
    lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''                           %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all
    prune-gone = !"git fetch -p && git branch -vv | awk '/: gone]/{print $1}' | xargs -r git branch -D"
	st = !"git --no-pager diff --shortstat HEAD && git --no-pager status -sb"
    unstage = rm --cached
[apply]
	whitespace = nowarn
[color]
	branch = auto
	diff = auto
	status = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[fetch]
    prune = true
[pull]
    ff = only
[push]
	default = simple
[status]
    submoduleSummary = true
[url "git@github.com:"]
	insteadOf = https://github.com/
[mergetool "nvim"]
    cmd = nvim -f -c \"Gdiff\" \"$MERGED\"
[pager]
    difftool = true
[init]
	defaultBranch = main
[includeIf "gitdir:~/w/"]
    path = ~/w/.gitconfig
